PORT=4000

# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://voc:voc@localhost:5432/voc?schema=public"

# Firebase Admin SDK — used only to verify ID tokens issued by the existing
# Firebase Auth on the frontend. Get these from Firebase Console >
# Project Settings > Service accounts > Generate new private key.
FIREBASE_PROJECT_ID=ai-chat-703e7
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Comma-separated list of origins allowed to call this API
CORS_ORIGINS=http://localhost:5173
