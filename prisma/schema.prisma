generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Mirrors a Firebase Auth user. The id is the Firebase UID (from the
/// verified ID token), not a generated one — see src/middleware/auth.ts.
model User {
  id          String   @id
  email       String?  @unique
  displayName String?
  photoUrl    String?
  createdAt   DateTime @default(now())

  /// Personal daily target the student sets for themself — lives on the
  /// account, not any one group's membership row, so it survives switching
  /// groups (mirrors users/{uid}/profile/wordTarget in the old RTDB tree).
  wordTarget Int?

  packs              Pack[]
  folders            Folder[]
  corpUser           CorpUser?
  groupMemberships   GroupMembership[]
  teacherJoinRequest TeacherJoinRequest?
  grammarAttempts    GrammarAttempt[]
  errorLogs          ErrorLog[]
}

model Folder {
  id     String  @id @default(cuid())
  name   String
  icon   String?
  userId String
  user   User    @relation(fields: [userId], references: [id])
  packs  Pack[]
}

model Pack {
  id          String  @id @default(cuid())
  name        String
  description String?
  icon        String?
  color       String?
  level       String?
  language    String?
  userId      String
  user        User    @relation(fields: [userId], references: [id])
  folderId    String?
  folder      Folder? @relation(fields: [folderId], references: [id])
  words       Word[]
}

model Word {
  id           String  @id @default(cuid())
  packId       String
  pack         Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  word         String
  translation  String?
  definition   String?
  example      String?
  notes        String?
  partOfSpeech String?

  /// Spaced-repetition progress (see VOC's src/utils/spacedRepetition.js,
  /// applyReview()/initWordProgress()). This state is computed entirely
  /// client-side — response timing, confidence self-rating, the memory-
  /// stability curve — the backend just stores and returns whatever the
  /// client sends, the same trust boundary as word/translation/etc. above,
  /// not a server-side re-implementation of the algorithm.
  mastery            Int?      @default(0)
  interval           Float?    @default(0)
  reviewCount        Int?      @default(0)
  nextReview         DateTime?
  lastReviewed       DateTime?
  stability          Float?
  activeRecallPasses Int?      @default(0)
  confirmedModes     Json?     @default("[]")
}

/// A crowd-sourced difficulty signal, aggregated across all users by
/// normalized word text (see normalizeWordKey in VOC's
/// src/experiment/experimentDB.js — lowercase + trim, no per-user split).
/// totalReviews only ever increases; totalCorrect <= totalReviews always.
model GlobalWordStat {
  wordKey      String @id
  totalReviews Int    @default(0)
  totalCorrect Int    @default(0)
}

model Center {
  id              String  @id @default(cuid())
  name            String
  email           String?
  phone           String?
  address         String?
  adminEmail      String?
  status          String  @default("active")
  /// Persistent per-center code a prospective teacher enters to request
  /// joining (distinct from a Group's per-group joinCode). Nullable until
  /// a center admin first requests one — see POST /corp/centers/:id/teacher-join-code.
  teacherJoinCode String? @unique

  corpUsers    CorpUser[]
  groups       Group[]
  customPacks  CorpPack[]
  joinRequests TeacherJoinRequest[]
}

enum CorpRole {
  CENTER_ADMIN
  TEACHER
}

/// A user's staff membership in exactly one center. Authorization for
/// everything under a center (see routes/corp) is derived from this row,
/// looked up server-side — never trusted from a client-supplied claim.
model CorpUser {
  id       String   @id @default(cuid())
  userId   String   @unique
  user     User     @relation(fields: [userId], references: [id])
  centerId String
  center   Center   @relation(fields: [centerId], references: [id])
  role     CorpRole
  name     String?
  phone    String?
  disabled Boolean  @default(false)

  groupsTaught Group[]
}

model Group {
  id              String   @id @default(cuid())
  centerId        String
  center          Center   @relation(fields: [centerId], references: [id])
  teacherId       String
  teacher         CorpUser @relation(fields: [teacherId], references: [id])
  name            String
  level           String?
  status          String   @default("active")
  /// The 6-digit PIN students enter to join — the only thing about a group
  /// that's meant to be guessable/public. Looked up server-side by
  /// POST /groups/join; never exposed as a way to bypass membership checks.
  joinCode        String   @unique
  /// CorpPack ids assigned to this group (kept as a plain id list, like the
  /// old RTDB centers/$id/groups/$id/assignedPacks — packs are shared
  /// center-wide content, not owned by any one group).
  assignedPackIds Json     @default("[]")

  memberships GroupMembership[]
  homework    HomeworkAssignment[]
}

/// Server-side source of truth for "is this user actually in this group".
/// Written only by POST /groups/join after verifying a group code — never
/// by the client directly. This is the fix for the VOC RTDB vulnerability:
/// the old Firebase rules authorized reads off a copy of this same fact
/// that the *client* wrote into its own user record (users/$uid/
/// groupMembership), which any authenticated client could forge to read
/// any center's data. Here, read access is checked against this table,
/// which only the join endpoint's server-side logic can write.
model GroupMembership {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id])
  joinedAt DateTime @default(now())

  /// The student's own display name/color on this group's roster — separate
  /// from User.displayName so a student can present differently per group.
  /// Only the student themself may write their own row (see PATCH
  /// /groups/:groupId/me) — a teacher's roster view is read-only for these.
  displayName String?
  avatarColor String?

  /// Per-pack, per-unit mastery snapshot: { [packId]: { units: { [unitKey]:
  /// { wordsLearned, totalWords, masteryPercent, retentionPercent,
  /// atRiskCount, lastActivity } } } }. Written only by the student
  /// themself (PATCH /groups/:groupId/me) — teachers have no read access to
  /// a student's raw word-level data, so this is what their roster reads
  /// instead, same trade-off the old RTDB tree made.
  progress Json @default("{}")

  @@unique([userId, groupId])
}

/// A personal-account user's not-yet-approved request to become a teacher
/// at a center (via Center.teacherJoinCode). Approving it (center_admin
/// only, see POST .../join-requests/:uid/approve) creates the CorpUser row
/// and deletes this request; nothing here grants access by itself.
model TeacherJoinRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  centerId    String
  center      Center   @relation(fields: [centerId], references: [id])
  name        String
  phone       String?
  requestedAt DateTime @default(now())

  @@unique([userId])
}

/// A center's shared vocabulary pack (distinct from a personal Pack).
/// Words are kept as an embedded JSON array (matching the old RTDB shape
/// { word, translation, definition, example }[]) rather than a relation —
/// a center pack is always read/written as one whole document, never
/// queried per-word, so there's nothing a relational Word table would buy
/// here that the personal-library Pack/Word split earns for that case.
model CorpPack {
  id          String   @id @default(cuid())
  centerId    String
  center      Center   @relation(fields: [centerId], references: [id])
  /// Set only for a teacher's private pack (vs. a center-wide shared one);
  /// see requireCenterStaff + the ownerUid check in routes/corpPacks.ts.
  ownerUid    String?
  title       String
  level       String   @default("Elementary")
  description String?
  language    String   @default("en-US")
  words       Json     @default("[]")
  createdAt   DateTime @default(now())
}

enum GrammarAttemptStatus {
  PENDING
  REVIEWED
}

/// A "complex" grammar test submission that needs a human to grade it
/// (e.g. free-form writing), as opposed to auto-scored exercises which
/// never touch the backend. Starts PENDING or, once a super admin scores
/// it (PATCH /grammar/attempts/:id), REVIEWED.
model GrammarAttempt {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id])
  testTitle    String?
  studentName  String?
  studentEmail String?
  answers      Json
  status       GrammarAttemptStatus @default(PENDING)
  score        Int?
  createdAt    DateTime             @default(now())
  reviewedAt   DateTime?
}

/// Client-side error reports (POST /errors, no auth requirement beyond a
/// valid session so anonymous crashes still get logged against a userId
/// when there is one). Read access is super-admin only.
model ErrorLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  message   String
  stack     String?
  url       String?
  userAgent String?
  context   String?
  createdAt DateTime @default(now())
}

/// Platform-wide announcement from a super admin, shown to center admins
/// and/or teachers depending on `target`.
model Announcement {
  id        String   @id @default(cuid())
  title     String
  message   String
  type      String   @default("info")
  target    String   @default("all")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// One round of homework a teacher assigns to a group — additive, never
/// replaces a past round (see POST .../groups/:groupId/homework).
/// `items` is [{ packId, monthId, unitId, packTitle, unitTitle, totalWords }].
model HomeworkAssignment {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id])
  name       String
  items      Json
  assignedAt DateTime @default(now())
}
